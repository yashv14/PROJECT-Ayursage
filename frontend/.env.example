# Public API prefix; includes /api. Vite loads frontend/.env.local automatically.
# Use the local development proxy to avoid cross-origin Flask requests.
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173
# Vite dev-server setting only; never put secrets in VITE_* variables.
FLASK_API_PROXY_TARGET=http://127.0.0.1:5000
